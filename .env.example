# Nome do arquivo .pfx dentro da pasta Certificados/ do projeto LoginEcac
CERT_PFX_PATH=meu_certificado.pfx

# Senha do certificado (opcional: se omitida, é lida automaticamente do Certificados/senhas.json)
# CERT_PFX_PASSPHRASE=senha_do_certificado

# Chave da API do Google Gemini (usada para resolver o hCaptcha)
GEMINI_API_KEY=sua_chave_gemini_aqui